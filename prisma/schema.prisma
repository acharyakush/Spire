generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model activities {
  id         Int       @id @default(autoincrement())
  user_id    String    @db.VarChar(8)
  activity   String    @db.VarChar(255)
  ip_address String    @db.VarChar(45)
  user_agent String    @db.Text
  created_at DateTime? @default(now()) @db.DateTime(0)
  session_id String    @db.VarChar(255)
  details    String?   @db.Text

  @@index([session_id], map: "session_id")
}

model administrators {
  id            String                 @id @db.Char(2)
  first_name    String                 @db.VarChar(100)
  last_name     String                 @db.VarChar(100)
  full_name     String                 @db.VarChar(500)
  username      String                 @unique(map: "username") @db.VarChar(50)
  email_address String                 @unique(map: "email_address") @db.VarChar(100)
  password      String                 @db.Text
  address       String                 @db.VarChar(500)
  birth_date    DateTime?              @db.Date
  gender        administrators_gender?
  phone_number  String                 @db.VarChar(15)
  designation   String                 @db.VarChar(100)
  permissions   String?                @db.MediumText
  employees     employees[]
}

model clients {
  id                                               String           @id @db.VarChar(8)
  name                                             String           @db.VarChar(200)
  affiliate_ids                                    String?          @db.VarChar(2000)
  company_id                                       String?          @db.VarChar(8)
  reference_id                                     String?          @db.VarChar(8)
  address                                          String?          @db.VarChar(500)
  contact_number                                   BigInt?
  email_address                                    String?          @db.VarChar(200)
  industry                                         String?          @db.VarChar(100)
  is_confirmed                                     Boolean?         @default(false)
  is_deleted                                       Boolean?         @default(false)
  joined_on                                        DateTime?        @default(now()) @db.DateTime(0)
  notes                                            String?          @db.VarChar(500)
  rating                                           Int?             @default(0) @db.UnsignedTinyInt
  tags                                             String?          @db.VarChar(500)
  created_at                                       DateTime?        @default(now()) @db.DateTime(0)
  created_by                                       String?          @db.VarChar(8)
  updated_at                                       DateTime?        @default(now()) @db.DateTime(0)
  updated_by                                       String?          @db.VarChar(8)
  references_clients_reference_idToreferences      the_references?  @relation("clients_reference_idToreferences", fields: [reference_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "clients_ibfk_1")
  companies                                        companies[]
  projects                                         projects[]
  the_references_the_references_client_idToclients the_references[] @relation("the_references_client_idToclients")

  @@index([reference_id], map: "reference_id")
}

model customers {
  id                                       Int                          @id @default(autoincrement())
  full_name                                String                       @db.VarChar(100)
  email_address                            String                       @unique(map: "email_address") @db.VarChar(100)
  contact_number                           String?                      @db.VarChar(20)
  address                                  String?                      @db.Text
  city                                     String?                      @db.VarChar(50)
  state                                    String?                      @db.VarChar(50)
  country                                  String?                      @db.VarChar(50)
  postal_code                              String?                      @db.VarChar(20)
  company_name                             String?                      @db.VarChar(100)
  industry                                 String?                      @db.VarChar(50)
  subscription_type                        customers_subscription_type? @default(Basic)
  license_key                              String?                      @db.VarChar(255)
  status                                   customers_status?            @default(Active)
  created_at                               DateTime?                    @default(now()) @db.DateTime(0)
  updated_at                               DateTime?                    @default(now()) @db.DateTime(0)
  notes                                    String?                      @db.Text
  licenses_customers_license_keyTolicenses licenses?                    @relation("customers_license_keyTolicenses", fields: [license_key], references: [license_key], onDelete: Restrict, onUpdate: Restrict, map: "customers_ibfk_1")
  licenses_licenses_customer_idTocustomers licenses[]                   @relation("licenses_customer_idTocustomers")

  @@index([license_key], map: "license_key")
}

model employees {
  id                         String                       @id @db.Char(8)
  administrator_id           String?                      @db.Char(2)
  first_name                 String                       @db.VarChar(100)
  last_name                  String?                      @db.VarChar(100)
  full_name                  String                       @db.VarChar(500)
  email_address              String                       @unique(map: "email_address") @db.VarChar(255)
  password                   String                       @db.VarChar(255)
  gender                     employees_gender?
  birth_date                 DateTime?                    @db.Date
  phone_number               String                       @db.VarChar(15)
  emergency_contact_name     String                       @db.VarChar(100)
  emergency_contact_relation String                       @db.VarChar(50)
  emergency_contact_phone    String                       @db.VarChar(15)
  address                    String                       @db.Text
  city                       String?                      @db.VarChar(100)
  state                      String?                      @db.VarChar(100)
  pincode                    String?                      @db.Char(6)
  employment_type            employees_employment_type?   @default(Intern)
  employment_status          employees_employment_status? @default(Active)
  joining_date               DateTime?                    @default(now()) @db.DateTime(0)
  termination_date           DateTime?                    @db.DateTime(0)
  termination_reason         String?                      @db.VarChar(1000)
  access_revoked             Boolean?                     @default(false)
  revocation_reason          String?                      @db.VarChar(1000)
  permissions                String                       @db.Text
  allow_remote_working       Boolean?                     @default(false)
  allowed_ip_addresses       String?                      @db.VarChar(200)
  last_login                 DateTime?                    @default(now()) @db.DateTime(0)
  skills                     String?                      @db.Text
  certifications             String?                      @db.Text
  is_active                  Boolean?                     @default(true)
  created_at                 DateTime?                    @default(now()) @db.DateTime(0)
  created_by                 String                       @db.Char(8)
  updated_at                 DateTime?                    @default(now()) @db.DateTime(0)
  updated_by                 String?                      @db.Char(8)
  notes                      String?                      @db.Text
  administrators             administrators?              @relation(fields: [administrator_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "employees_ibfk_1")

  @@index([administrator_id], map: "administrator_id")
}

model inquiries {
  id              String           @id @db.VarChar(8)
  client_id       String           @db.VarChar(8)
  reference_id    String           @db.VarChar(8)
  main_project_id String           @db.VarChar(8)
  sub_project_id  String           @db.VarChar(8)
  contact_number  BigInt
  entry_date      DateTime?        @default(now()) @db.DateTime(0)
  email_address   String           @db.VarChar(200)
  follow_ups      String           @db.VarChar(255)
  is_closed       Boolean?         @default(false)
  closure_reason  String?          @db.VarChar(255)
  quote           Decimal          @default(2500.00) @db.Decimal(10, 2)
  status          inquiries_status @default(Open)
  tags            String?          @db.VarChar(255)
  created_at      DateTime?        @default(now()) @db.DateTime(0)
  created_by      String           @db.VarChar(8)
  updated_at      DateTime?        @default(now()) @db.DateTime(0)
  updated_by      String?          @db.VarChar(8)
  notes           notes[]
  projects        projects[]
}

model licenses {
  id                                        Int              @id @default(autoincrement())
  customer_id                               Int?
  license_key                               String           @unique(map: "license_key") @db.VarChar(255)
  encrypted_license_data                    String           @db.Text
  expiration_date                           DateTime         @db.DateTime(0)
  status                                    licenses_status? @default(Active)
  created_at                                DateTime?        @default(now()) @db.DateTime(0)
  created_by                                String           @db.VarChar(8)
  updated_at                                DateTime?        @default(now()) @db.DateTime(0)
  updated_by                                String?          @db.VarChar(8)
  customers_customers_license_keyTolicenses customers[]      @relation("customers_license_keyTolicenses")
  customers_licenses_customer_idTocustomers customers?       @relation("licenses_customer_idTocustomers", fields: [customer_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "licenses_ibfk_1")

  @@index([customer_id], map: "customer_id")
}

model main_projects {
  id            String     @id @db.VarChar(8)
  name          String     @db.VarChar(255)
  created_at    DateTime?  @default(now()) @db.DateTime(0)
  created_by    String     @db.VarChar(8)
  updated_at    DateTime?  @default(now()) @db.DateTime(0)
  updated_by    String?    @db.VarChar(8)
  update_reason String?    @db.Text
  projects      projects[]

  @@index([name], map: "name")
}

model permissions {
  id                 Int               @id @default(autoincrement())
  name               String            @unique(map: "name") @db.VarChar(255)
  module             String            @db.VarChar(50)
  type               permissions_type?
  sidebar_visibility Boolean

  @@index([module], map: "module")
}

model statuses {
  id       Int     @id @default(autoincrement())
  entity   String? @db.VarChar(50)
  statuses String  @db.LongText
}

model sub_projects {
  id            String     @id @db.VarChar(8)
  name          String     @db.VarChar(255)
  created_at    DateTime?  @default(now()) @db.DateTime(0)
  created_by    String     @db.VarChar(8)
  updated_at    DateTime?  @default(now()) @db.DateTime(0)
  updated_by    String?    @db.VarChar(8)
  update_reason String?    @db.Text
  projects      projects[]

  @@index([name], map: "name")
}

model companies {
  id                    String     @id @db.VarChar(8)
  client_id             String     @db.VarChar(8)
  name                  String     @db.VarChar(200)
  contact_number        String?    @db.VarChar(15)
  email_address         String?    @unique(map: "email_address") @db.VarChar(200)
  address               String?    @db.VarChar(255)
  pan                   String?    @db.VarChar(10)
  gst                   String?    @db.VarChar(15)
  reimbursement_voucher Decimal?   @db.Decimal(12, 2)
  invoice_fees          Decimal?   @db.Decimal(12, 2)
  total_affiliate_fees  Decimal?   @db.Decimal(12, 2)
  created_at            DateTime   @default(now()) @db.DateTime(0)
  created_by            String     @db.VarChar(8)
  updated_at            DateTime   @default(now()) @db.DateTime(0)
  updated_by            String?    @db.VarChar(8)
  clients               clients    @relation(fields: [client_id], references: [id], onDelete: Cascade, map: "fk_company_client")
  projects              projects[]

  @@index([client_id], map: "fk_company_client")
  @@index([contact_number], map: "idx_company_contact_number")
  @@index([email_address], map: "idx_company_email")
  @@index([name], map: "idx_company_name")
}

model notes {
  id         Int       @id @default(autoincrement())
  inquiry_id String    @db.VarChar(8)
  project_id String    @db.VarChar(8)
  user_id    String    @db.VarChar(8)
  content    String    @db.VarChar(1000)
  entered_on DateTime  @default(now()) @db.DateTime(0)
  source     String    @db.VarChar(20)
  inquiries  inquiries @relation(fields: [inquiry_id], references: [id], onUpdate: Restrict, map: "fk_note_inquiry_id")
  projects   projects  @relation(fields: [project_id], references: [id], onUpdate: Restrict, map: "fk_note_project_id")

  @@index([inquiry_id], map: "fk_note_inquiry_id")
  @@index([project_id], map: "fk_note_project_id")
}

model projects {
  id                    String          @id @db.VarChar(8)
  client_id             String          @db.VarChar(8)
  company_id            String          @db.VarChar(8)
  affiliate_ids         String          @db.VarChar(2000)
  inquiry_id            String          @db.VarChar(8)
  government_id         String?         @db.VarChar(100)
  main_project_id       String          @db.VarChar(8)
  sub_project_id        String          @db.VarChar(8)
  quote                 Decimal         @db.Decimal(10, 2)
  due_on                DateTime        @default(now()) @db.DateTime(0)
  total_affiliate_fees  Decimal         @db.Decimal(10, 2)
  reimbursement_voucher Decimal         @db.Decimal(10, 2)
  invoice_fees          Decimal         @db.Decimal(10, 2)
  invoice_firm          String          @db.VarChar(500)
  teams                 String          @db.VarChar(500)
  started_on            DateTime        @default(now()) @db.DateTime(0)
  status                projects_status
  is_deleted            Boolean?        @default(false)
  is_edited             Boolean?        @default(false)
  created_at            DateTime        @default(now()) @db.DateTime(0)
  created_by            String          @db.VarChar(8)
  updated_at            DateTime        @default(now()) @db.DateTime(0)
  updated_by            String?         @db.VarChar(8)
  notes                 notes[]
  clients               clients         @relation(fields: [client_id], references: [id], onUpdate: Restrict, map: "fk_project_client_id")
  companies             companies       @relation(fields: [company_id], references: [id], onUpdate: Restrict, map: "fk_project_company_id")
  inquiries             inquiries       @relation(fields: [inquiry_id], references: [id], onUpdate: Restrict, map: "fk_project_inquiry_id")
  main_projects         main_projects   @relation(fields: [main_project_id], references: [id], onUpdate: Restrict, map: "fk_project_main_project_id")
  sub_projects          sub_projects    @relation(fields: [sub_project_id], references: [id], onUpdate: Restrict, map: "fk_project_sub_project_id")

  @@index([client_id], map: "fk_project_client_id")
  @@index([company_id], map: "fk_project_company_id")
  @@index([inquiry_id], map: "fk_project_inquiry_id")
  @@index([main_project_id], map: "fk_project_main_project_id")
  @@index([sub_project_id], map: "fk_project_sub_project_id")
}

model the_references {
  id                                        String    @id @db.VarChar(8)
  name                                      String    @db.VarChar(100)
  client_id                                 String    @db.VarChar(8)
  address                                   String?   @db.VarChar(200)
  contact_number                            BigInt?
  email_address                             String?   @db.VarChar(200)
  is_deleted                                Boolean?  @default(false)
  joined_on                                 DateTime? @default(now()) @db.DateTime(0)
  notes                                     String?   @db.VarChar(500)
  organization                              String?   @db.VarChar(200)
  rating                                    Int?      @default(0) @db.UnsignedTinyInt
  relationship                              String?   @db.VarChar(100)
  tags                                      String?   @db.VarChar(500)
  created_at                                DateTime? @default(now()) @db.DateTime(0)
  created_by                                String?   @db.VarChar(8)
  updated_at                                DateTime? @default(now()) @db.DateTime(0)
  updated_by                                String?   @db.VarChar(8)
  clients_clients_reference_idToreferences  clients[] @relation("clients_reference_idToreferences")
  clients_the_references_client_idToclients clients   @relation("the_references_client_idToclients", fields: [client_id], references: [id], onUpdate: Restrict, map: "fk_reference_client_id")

  @@index([client_id], map: "client_id")
}

enum permissions_type {
  Base
  Derived
}

enum licenses_status {
  Active
  Expired
  Revoked
}

enum employees_gender {
  Male
  Female
  Other
  Prefer_not_to_say @map("Prefer not to say")
}

enum administrators_gender {
  Male
  Female
  Other
  Prefer_not_to_say @map("Prefer not to say")
}

enum customers_subscription_type {
  Basic
  Enterprise
  Free
  Premium
}

enum customers_status {
  Active
  Inactive
  Suspended
}

enum inquiries_status {
  Closed
  Confirmed
  Hold
  Open
}

enum employees_employment_type {
  Annually_Confirmed    @map("Annually Confirmed")
  Articleship
  Half_Yearly_Confirmed @map("Half Yearly Confirmed")
  Intern
  On_Contract           @map("On Contract")
  Permanent
  Quarterly_Confirmed   @map("Quarterly Confirmed")
}

enum employees_employment_status {
  Active
  Ad_Hoc      @map("Ad-Hoc")
  Inactive
  Intern
  On_Contract @map("On Contract")
  On_Leave    @map("On Leave")
  Probation
  Resigned
  Terminated
}

enum projects_status {
  Active
  Completed
  On_Hold   @map("On Hold")
  Cancelled
}
