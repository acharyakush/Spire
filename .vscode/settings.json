{
	"css.styleSheets": ["public/styles/globals.css"],
	"debug.console.fontFamily": "'Droid Sans Mono', Consolas, 'Courier New', monospace",
	"debug.console.fontSize": 17,
	"editor.acceptSuggestionOnEnter": "smart",
	"editor.autoClosingBrackets": "always",
	"editor.autoClosingComments": "always",
	"editor.autoClosingDelete": "always",
	"editor.autoClosingQuotes": "always",
	"editor.autoIndent": "advanced",
	"editor.bracketPairColorization.independentColorPoolPerBracketType": true,
	"editor.codeActionsOnSave": {
		"source.fixAll": "always",
		"source.organizeImports": "never"
	},
	"editor.cursorBlinking": "smooth",
	"editor.cursorSmoothCaretAnimation": "on",
	"editor.defaultFormatter": "esbenp.prettier-vscode",
	"editor.fontFamily": "'Droid Sans Mono', Consolas, 'Courier New', monospace",
	"editor.fontLigatures": true,
	"editor.fontSize": 17,
	"editor.formatOnSave": true,
	"editor.formatOnSaveMode": "file",
	"editor.formatOnType": true,
	"editor.foldingImportsByDefault": true,
	"editor.foldingStrategy": "indentation",
	"editor.guides.bracketPairs": true,
	"editor.guides.highlightActiveIndentation": true,
	"editor.indentSize": "tabSize",
	"editor.insertSpaces": true,
	"editor.linkedEditing": true,
	"editor.parameterHints.enabled": true,
	"editor.quickSuggestions": {
		"other": "on",
		"comments": "off",
		"strings": "on"
	},
	"editor.smoothScrolling": true,
	"editor.suggest.snippetsPreventQuickSuggestions": false,
	"editor.suggestSelection": "first",
	"editor.tabCompletion": "on",
	"editor.tabSize": 4,
	"editor.wrappingIndent": "indent",
	"editor.wrappingStrategy": "advanced",
	"editor.wordWrap": "on",
	"files.autoSave": "off",
	"files.watcherExclude": {
		"**/.git/objects/**": true,
		"**/.git/subtree-cache/**": true,
		"**/node_modules/**": true
	},
	"javascript.referencesCodeLens.enabled": true,
	"javascript.suggest.autoImports": true,
	"javascript.suggest.completeFunctionCalls": true,
	"javascript.updateImportsOnFileMove.enabled": "always",
	"javascript.validate.enable": true,
	"prettier.bracketSameLine": true,
	"prettier.htmlWhitespaceSensitivity": "ignore",
	"prettier.printWidth": 240,
	"prettier.semi": true,
	"prettier.singleAttributePerLine": false,
	"prettier.singleQuote": false,
	"prettier.tabWidth": 4,
	"prettier.trailingComma": "all",
	"prettier.useTabs": true,
	"search.exclude": {
		"**/node_modules": true
	},
	"terminal.integrated.fontFamily": "'Droid Sans Mono', Consolas, 'Courier New', monospace",
	"terminal.integrated.fontSize": 17,
	"window.autoDetectColorScheme": true,
	"workbench.preferredLightColorTheme": "One Dark Pro Mix"
}
